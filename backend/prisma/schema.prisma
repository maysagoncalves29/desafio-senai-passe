generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        Int       @id @default(autoincrement())
  name      String    @map("nome") @db.VarChar(100)
  position  String    @map("posicao") @db.VarChar(3)
  agility   Int       @map("agilidade")
  age       Int       @map("idade")
  baseValue Decimal   @map("valor_base") @db.Decimal(6, 2)
  condition String    @default("APTO") @map("condicao") @db.VarChar(20)
  clubId    Int?      @map("clube_id")
  pace      Int       @map("velocidade")
  shooting  Int       @map("finalizacao")
  passing   Int       @map("passe")
  dribbling Int       @map("drible")
  defending Int       @map("defesa")
  physical  Int       @map("fisico")
  potential Int       @map("potencial")
  deletedAt DateTime? @map("excluido_em")
  createdAt DateTime  @default(now()) @map("criado_em")
  updatedAt DateTime  @default(now()) @updatedAt @map("atualizado_em")

  club         Club?             @relation(fields: [clubId], references: [id])
  contracts    Contract[]
  transactions ClubTransaction[]
  lineupSlot   LineupSlot?
  attacks      MatchDuel[]       @relation("DuelAttacker")
  defenses     MatchDuel[]       @relation("DuelDefender")

  @@index([clubId])
  @@map("jogadores")
}

model Club {
  id             Int      @id @default(autoincrement())
  name           String   @map("nome") @db.VarChar(60)
  normalizedName String   @unique @map("nome_normalizado") @db.VarChar(120)
  acronym        String   @unique @map("sigla") @db.Char(3)
  cash           Decimal  @default(300.00) @map("caixa") @db.Decimal(10, 2)
  formation      String?  @map("formacao") @db.VarChar(5)
  createdAt      DateTime @default(now()) @map("criado_em")

  players      Player[]
  contracts    Contract[]
  transactions ClubTransaction[]
  lineup       LineupSlot[]
  homeMatches  Match[]           @relation("MatchHome")
  awayMatches  Match[]           @relation("MatchAway")
  duels        MatchDuel[]

  @@map("clubes")
}

model Contract {
  id            Int       @id @default(autoincrement())
  playerId      Int       @map("jogador_id")
  clubId        Int       @map("clube_id")
  purchaseValue Decimal   @map("valor_compra") @db.Decimal(6, 2)
  loyaltyUntil  DateTime  @map("fidelidade_ate")
  status        String    @map("situacao") @db.VarChar(12)
  startedAt     DateTime  @default(now()) @map("iniciado_em")
  endedAt       DateTime? @map("encerrado_em")

  player Player @relation(fields: [playerId], references: [id])
  club   Club   @relation(fields: [clubId], references: [id])

  @@index([playerId, status])
  @@index([clubId])
  @@map("contratos")
}

model ClubTransaction {
  id         Int      @id @default(autoincrement())
  clubId     Int      @map("clube_id")
  playerId   Int      @map("jogador_id")
  playerName String   @map("nome_jogador") @db.VarChar(100)
  type       String   @map("tipo") @db.VarChar(6)
  value      Decimal  @map("valor") @db.Decimal(6, 2)
  fee        Decimal  @map("taxa") @db.Decimal(6, 2)
  penalty    Decimal  @map("multa") @db.Decimal(6, 2)
  profit     Decimal? @map("lucro") @db.Decimal(7, 2)
  cashChange Decimal  @map("variacao_caixa") @db.Decimal(8, 2)
  createdAt  DateTime @map("criado_em")

  club   Club   @relation(fields: [clubId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@index([clubId, createdAt])
  @@map("transacoes")
}

model LineupSlot {
  clubId    Int      @map("clube_id")
  playerId  Int      @unique @map("jogador_id")
  createdAt DateTime @default(now()) @map("criado_em")

  club   Club   @relation(fields: [clubId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@id([clubId, playerId])
  @@map("escalacoes")
}

model Match {
  id            Int      @id @default(autoincrement())
  homeClubId    Int      @map("mandante_id")
  awayClubId    Int      @map("visitante_id")
  homeGoals     Int      @map("gols_mandante")
  awayGoals     Int      @map("gols_visitante")
  homeFormation String   @map("formacao_mandante") @db.VarChar(5)
  awayFormation String   @map("formacao_visitante") @db.VarChar(5)
  playedAt      DateTime @map("jogada_em")

  homeClub Club        @relation("MatchHome", fields: [homeClubId], references: [id])
  awayClub Club        @relation("MatchAway", fields: [awayClubId], references: [id])
  duels    MatchDuel[]

  @@index([playedAt, id])
  @@map("partidas")
}

model MatchDuel {
  id                Int     @id @default(autoincrement())
  matchId           Int     @map("partida_id")
  order             Int     @map("ordem")
  attackingClubId   Int     @map("clube_atacante_id")
  attackerId        Int     @map("atacante_id")
  defenderId        Int     @map("defensor_id")
  attackerName      String  @map("nome_atacante") @db.VarChar(100)
  defenderName      String  @map("nome_defensor") @db.VarChar(100)
  attackerPosition  String  @map("posicao_atacante") @db.VarChar(3)
  defenderPosition  String  @map("posicao_defensor") @db.VarChar(3)
  attackerCondition String  @map("condicao_atacante") @db.VarChar(20)
  defenderCondition String  @map("condicao_defensor") @db.VarChar(20)
  attackAttribute   String  @map("atributo_ataque") @db.VarChar(10)
  defenseAttribute  String  @map("atributo_defesa") @db.VarChar(10)
  attackValue       Int     @map("valor_ataque")
  defenseValue      Int     @map("valor_defesa")
  goal              Boolean @map("gol")

  match         Match  @relation(fields: [matchId], references: [id])
  attackingClub Club   @relation(fields: [attackingClubId], references: [id])
  attacker      Player @relation("DuelAttacker", fields: [attackerId], references: [id])
  defender      Player @relation("DuelDefender", fields: [defenderId], references: [id])

  @@unique([matchId, order])
  @@map("duelos_partida")
}
